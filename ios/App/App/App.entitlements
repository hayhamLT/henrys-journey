<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<key>com.apple.developer.game-center</key>
	<true/>
	<key>com.apple.developer.associated-domains</key>
	<array>
		<string>applinks:henry-s-journey.web.app</string>
		<string>applinks:henrysjourney.app</string>
	</array>
	<key>aps-environment</key>
	<string>development</string>
	<key>com.apple.security.application-groups</key>
	<array>
		<string>group.com.henrysjourney.app.shared</string>
	</array>
	<!-- GoogleSignIn stores OAuth state in the Keychain; without a keychain
	     access group it throws "keychain error" and sign-in fails right after
	     the account picker. This group must match the app's bundle ID. -->
	<key>keychain-access-groups</key>
	<array>
		<string>$(AppIdentifierPrefix)com.henrysjourney.app</string>
	</array>
</dict>
</plist>
