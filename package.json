{
  "name": "henrys-journey",
  "private": true,
  "version": "0.9.7b",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "typecheck": "tsc --noEmit",
    "lint": "eslint \"**/*.{ts,tsx}\"",
